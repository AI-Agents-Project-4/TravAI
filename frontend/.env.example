# Copy to .env.local (git-ignored). Public values only: NEXT_PUBLIC_ vars ship to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# true = use the in-browser mock backend (made-up prices, "Demo data" banner)
# while the real endpoints are being built. Never true for the demo or user test.
NEXT_PUBLIC_API_MOCK=false
