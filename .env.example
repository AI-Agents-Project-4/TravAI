# Copy to .env (git-ignored). Used by docker-compose.yml and the backend.

# Local Postgres (docker compose up -d db)
POSTGRES_USER=travai
POSTGRES_PASSWORD=travai
POSTGRES_DB=travai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://travai:travai@localhost:5432/travai

# Backend API keys go here, never in frontend/ or NEXT_PUBLIC_* vars.
# The research agent's keys (Geoapify etc.) live in researchAgent/.env (see its README).

# --- Backend planner (backend/app/config.py has every setting) ---
# cli = `claude -p` on your Claude plan (no key); api = Anthropic SDK (needs ANTHROPIC_API_KEY);
# none = no model, rule-based plans that say so.
# PLANNER_LLM=cli
# PLANNER_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# two_agent = research -> planner (the design); single = the eval's one-agent baseline.
# AGENT_MODE=two_agent
# true = replay research only from the research agent's cache (tests/CI); nothing goes out.
# RESEARCH_OFFLINE=false
# Reuse identical research from the last N hours instead of researching again (0 = off).
# RESEARCH_REUSE_HOURS=24
# Never set TRAVAI_ALLOW_NETWORK for the backend: it refuses to start if it's set.
