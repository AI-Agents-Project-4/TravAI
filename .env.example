# Copy to .env (git-ignored). Used by docker-compose.yml and the backend.

# Local Postgres (docker compose up -d db)
POSTGRES_USER=travai
POSTGRES_PASSWORD=travai
POSTGRES_DB=travai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://travai:travai@localhost:5432/travai

# Backend API keys go here, never in frontend/ or NEXT_PUBLIC_* vars.
# Names TBD by Jake/Kyle, e.g.:
# ANTHROPIC_API_KEY=
